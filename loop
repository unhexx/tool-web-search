#!/usr/bin/env bash
# Второй шаг: Orchestrator → Coder → Tester → Debugger → Reviewer.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
if [[ ! -f .venv/bin/activate ]]; then
  echo "Сначала ./init" >&2
  exit 1
fi
# shellcheck disable=SC1091
source .venv/bin/activate
exec python -m tool_web_search.loop "$@"
